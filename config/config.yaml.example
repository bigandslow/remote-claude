# Remote Claude Configuration
# Copy to ~/.config/remote-claude/config.yaml

docker:
  # Docker image name for Claude containers
  image: remote-claude:latest

network:
  # Network isolation mode: "allowlist", "bridge", or "none"
  mode: allowlist

  # Allowed domains when mode is "allowlist"
  allowed_domains:
    - github.com
    - api.github.com
    - pypi.org
    - files.pythonhosted.org
    - registry.npmjs.org
    - api.anthropic.com

credentials:
  # Paths to credential files/directories (mounted read-only into containers)
  anthropic: ~/.anthropic
  git: ~/.gitconfig
  ssh: ~/.ssh
  claude: ~/.claude

  # Dedicated Claude credentials (optional, recommended for YOLO mode)
  # Run ./setup/credentials-setup.sh to configure these
  # If set, these are used instead of personal credentials above
  #
  # Option 1: Bot Account (single GitHub user with SSH key)
  # claude_git: ~/.config/remote-claude/credentials/git/.gitconfig
  # claude_ssh: ~/.config/remote-claude/credentials/git/.ssh
  #
  # Option 2: Deploy Keys (per-repository SSH keys, works with GitHub EMU)
  # Recommended for Enterprise Managed Users environments
  # deploy_keys_git: ~/.config/remote-claude/credentials/deploy-keys/.gitconfig
  # deploy_keys_ssh: ~/.config/remote-claude/credentials/deploy-keys/.ssh
  # deploy_keys_registry: ~/.config/remote-claude/credentials/deploy-keys/registry.json
  #
  # GCP service account (works with either GitHub auth method)
  # claude_gcp: ~/.config/remote-claude/credentials/gcp/claude-sa-key.json

notifications:
  # Enable webhook notifications
  enabled: false

  # Webhook URL for notifications when Claude needs input
  # Supported services:
  #   - ntfy.sh:    https://ntfy.sh/your-topic
  #   - Slack:      https://hooks.slack.com/services/xxx/yyy/zzz
  #   - Discord:    https://discord.com/api/webhooks/xxx/yyy
  #   - Pushover:   https://api.pushover.net/1/messages.json
  #   - Generic:    Any URL accepting JSON POST
  webhook_url: null

  # Idle detection settings (used by watch.py)
  idle_threshold: 300      # Seconds before considering session idle (5 min)
  check_interval: 30       # Seconds between idle checks
  min_notification_gap: 60 # Minimum seconds between notifications

tmux:
  # Prefix for tmux session names
  session_prefix: rc
  # Tmux socket name (allows isolation from other tmux sessions)
  socket_name: remote-claude

# Cloud infrastructure (optional)
# Enables running sessions on cloud VMs via Tailscale
# Supports DigitalOcean and Hetzner Cloud
#
# cloud:
#   enabled: true
#
#   # Cloud provider: "digitalocean" or "hetzner"
#   provider: digitalocean
#
#   # API token (stored in 1Password, fetched via op-wrapper)
#   api_token_ref: "op://Infrastructure/DigitalOcean/api-token"
#
#   # Tailscale OAuth credentials for auto-provisioning auth keys
#   tailscale_oauth_client_id: "k1234567890"
#   tailscale_oauth_secret_ref: "op://Infrastructure/Tailscale/oauth-secret"
#
#   # Default server type and region for new nodes (provider-specific)
#   # Leave blank to use provider defaults
#   #
#   # DigitalOcean:
#   #   Server types: s-1vcpu-1gb ($6), s-2vcpu-4gb ($24), s-4vcpu-8gb ($48)
#   #   Regions: nyc (NYC), sfo (SFO), lon (London), ams (Amsterdam), sgp (Singapore), tor (Toronto)
#   #   Defaults: s-2vcpu-4gb, nyc3
#   #
#   # Hetzner:
#   #   Server types: cpx11 ($4.35), cpx21 ($8.99), cpx31 ($16.49)
#   #   Regions: ash (Ashburn), hil (Hillsboro), fsn (Falkenstein), nbg (Nuremberg), hel (Helsinki)
#   #   Defaults: cpx21, ash
#   #
#   # default_server_type: s-2vcpu-4gb
#   # default_region: nyc
#
#   # Session placement strategy: auto | manual | round-robin
#   placement: auto
#
#   # Maximum concurrent sessions per cloud node
#   max_sessions_per_node: 6
#
#   # Provisioned nodes (managed by 'rc cloud node add/remove')
#   nodes: []
